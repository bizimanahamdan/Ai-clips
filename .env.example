########################################
# Required server-only configuration
########################################
# PostgreSQL. Render can inject this from its managed PostgreSQL service.
DATABASE_URL=postgresql://user:password@host:5432/clipforge

# Groq remains required for Whisper transcription and is an analysis fallback.
GROQ_API_KEY=
# Direct Gemini is preferred for chunked long-transcript analysis.
GEMINI_API_KEY=
# Optional analysis fallback between direct Gemini and Groq.
OPENROUTER_API_KEY=

# Cloudflare R2 S3 credentials. Create an R2 API token with Object Read & Write
# permission for my-clips-storage. These values must never use NEXT_PUBLIC_ names.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=my-clips-storage
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com

# Public origin of this same application (no trailing slash).
FRONTEND_URL=https://your-clipforge-service.onrender.com

########################################
# Optional tuning (safe defaults shown)
########################################
GROQ_TRANSCRIBE_MODEL=whisper-large-v3-turbo
# Analysis model IDs are configurable because provider/account availability varies.
GEMINI_TEXT_MODEL=gemini-2.5-flash
GROQ_TEXT_MODEL=openai/gpt-oss-20b
OPENROUTER_TEXT_MODEL=google/gemini-2.5-flash
# Ordered primary/fallback strategy.
ANALYSIS_PROVIDERS=gemini,openrouter,groq
OPENROUTER_SITE_URL=
OPENROUTER_SITE_NAME=ClipForge

# Ephemeral scratch space used only during active FFmpeg jobs.
STORAGE_DIR=/tmp/clipforge
RETENTION_HOURS=24
MIN_FREE_DISK_MB=1500
CLEANUP_INTERVAL_MINUTES=15

MAX_UPLOAD_MB=400
# Persistent Media Library audio limits (background music and sound effects).
MAX_MUSIC_UPLOAD_MB=50
MAX_MUSIC_DURATION_MINUTES=30
MAX_DURATION_MINUTES=120
MAX_URL_SIZE_MB=800
URL_DOWNLOAD_TIMEOUT_SEC=600
# Every redirect is revalidated against public-network-only SSRF rules.
MAX_URL_REDIRECTS=5
# false = direct URL source is scratch-only; true = retain it in R2 until job expiry.
PERSIST_URL_SOURCES=false
AUDIO_CHUNK_SEC=600
AUDIO_CHUNK_OVERLAP_SEC=1.5
TRANSCRIBE_TIMEOUT_SEC=600
ANALYSIS_TIMEOUT_SEC=180
# One corrected retry per provider (runtime caps this at one to avoid duplicate spend).
ANALYSIS_MAX_RETRIES=1
# Ask for more candidates than needed, then validate/rank/de-overlap locally.
ANALYSIS_CANDIDATE_MULTIPLIER=3
# Per-request transcript bounds. Long videos are split at timestamped segments.
ANALYSIS_TRANSCRIPT_MAX_CHARS=18000
ANALYSIS_CHUNK_MAX_SECONDS=720
ANALYSIS_CHUNK_OVERLAP_SEC=30
# Groq is skipped for prompts above this conservative character estimate.
ANALYSIS_GROQ_SAFE_CHARS=20000

# 9:16 output size, followed by square and landscape output sizes.
TARGET_WIDTH=1080
TARGET_HEIGHT=1920
OUTPUT_SQUARE_SIZE=1080
OUTPUT_LANDSCAPE_WIDTH=1920
OUTPUT_LANDSCAPE_HEIGHT=1080
TARGET_FPS=30
VIDEO_CRF=23
VIDEO_PRESET=veryfast
AUDIO_BITRATE_K=128

# Keep at 1 unless the server has enough CPU/RAM for parallel FFmpeg jobs.
MAX_CONCURRENT_JOBS=1
DEFAULT_CLIP_COUNT=3
MAX_CLIP_COUNT=8
MIN_CLIP_SEC=12
MAX_CLIP_SEC=90
DATABASE_POOL_MAX=10

# Docker sets these. Only set manually for a non-Docker deployment.
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe
