########################################
# Required
########################################

# PostgreSQL connection (job state + clip metadata)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Groq — used for BOTH transcription (Whisper) and clip analysis (fast, primary)
GROQ_API_KEY=

########################################
# Optional
########################################

# OpenRouter — optional fallback for clip analysis if Groq fails / is rate limited
OPENROUTER_API_KEY=

########################################
# Models (defaults shown)
########################################
GROQ_TRANSCRIBE_MODEL=whisper-large-v3-turbo
GROQ_TEXT_MODEL=llama-3.3-70b-versatile
OPENROUTER_TEXT_MODEL=google/gemini-2.5-flash
# Which provider tries first for clip analysis: groq, openrouter (comma separated)
ANALYSIS_PROVIDERS=groq,openrouter

########################################
# Storage / lifecycle
########################################
# Any writable path on the cloud host. Use a disk, not an ephemeral lambda FS.
STORAGE_DIR=/tmp/clipforge
# Clips + job records are deleted after this many hours
RETENTION_HOURS=6
# Refuse a job if free disk space is below this (MB)
MIN_FREE_DISK_MB=1500
# In-process cleanup scheduler frequency
CLEANUP_INTERVAL_MINUTES=15

########################################
# Ingest limits
########################################
MAX_UPLOAD_MB=400
MAX_DURATION_MINUTES=120
MAX_URL_SIZE_MB=800
URL_DOWNLOAD_TIMEOUT_SEC=600
# Set to 1 only on hosts where the `yt-dlp` binary is installed
ALLOW_YTDLP=true

########################################
# Transcription
########################################
# Groq's free tier caps uploads at 25MB, so audio is chunked at this length
AUDIO_CHUNK_SEC=600
AUDIO_CHUNK_OVERLAP_SEC=1.5
TRANSCRIBE_TIMEOUT_SEC=600

########################################
# AI analysis
########################################
ANALYSIS_TIMEOUT_SEC=180
ANALYSIS_MAX_RETRIES=2

########################################
# Output rendering
########################################
TARGET_WIDTH=1080
TARGET_HEIGHT=1920
TARGET_FPS=30
VIDEO_CRF=23
# veryfast | faster | fast | medium  (lower CPU usage = veryfast)
VIDEO_PRESET=veryfast
AUDIO_BITRATE_K=128

########################################
# Job queue
########################################
# Keep at 1 on a small cloud instance: FFmpeg is CPU-hungry
MAX_CONCURRENT_JOBS=1
DEFAULT_CLIP_COUNT=3
MAX_CLIP_COUNT=8
MIN_CLIP_SEC=12
MAX_CLIP_SEC=90

########################################
# OpenRouter attribution (optional, only used when OpenRouter is called)
########################################
OPENROUTER_SITE_URL=
OPENROUTER_SITE_NAME=
